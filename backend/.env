
import os
import hmac
import hashlib
from fastapi import FastAPI, Header, HTTPException, Request
from dotenv import load_dotenv

load_dotenv()

app = FastAPI(
    title="SentinelOps API",
    description="AI-powered AIOps Observability Platform",
    version="1.0.0"
)

API_KEY = os.getenv("SENTINEL_API_KEY", "")
HMAC_SECRET = os.getenv("SENTINEL_HMAC_SECRET", "")


@app.get("/")
async def root():
    return {
        "name": "SentinelOps",
        "status": "online",
        "message": "Backend is running"
    }


@app.get("/health")
async def health():
    return {"status": "healthy"}


@app.post("/api/v1/ingest")
async def ingest(
    request: Request,
    x_api_key: str = Header(default=""),
    x_hmac_signature: str = Header(default="")
):
    if not API_KEY or not HMAC_SECRET:
        raise HTTPException(503, "Server authentication is not configured")

    if not hmac.compare_digest(x_api_key, API_KEY):
        raise HTTPException(401, "Invalid API key")

    body = await request.body()

    expected_signature = hmac.new(
        HMAC_SECRET.encode(),
        body,
        hashlib.sha256
    ).hexdigest()

    if not hmac.compare_digest(
        expected_signature,
        x_hmac_signature
    ):
        raise HTTPException(401, "Invalid HMAC signature")

    try:
        payload = await request.json()
    except Exception:
        raise HTTPException(400, "Invalid JSON payload")

    return {
        "status": "success",
        "message": "Telemetry received",
        "collector_id": payload.get("collector_id", "unknown")
    }
